import os, datetime
from flask import Flask, request, render_template_string, jsonify, send_from_directory

app = Flask(__name__)
# Folder where snapshots will be saved on the Base RPi
SAVE_DIR = "snapshots"
if not os.path.exists(SAVE_DIR): os.makedirs(SAVE_DIR)

latest_telemetry = {"roll": 0, "pitch": 0, "yaw": 0, "alt": 0}

HTML_PAGE = """
<!DOCTYPE html>
<html>
<head>
    <title>Drone Dashboard</title>
    <style>
        body { font-family: sans-serif; background: #121212; color: #00ff00; text-align: center; }
        .stats { display: flex; justify-content: center; gap: 20px; margin: 20px; }
        .box { background: #222; padding: 15px; border-radius: 10px; border: 1px solid #444; min-width: 120px; }
        .val { display: block; font-size: 24px; color: white; font-weight: bold; }
        img { width: 640px; border: 3px solid #444; border-radius: 10px; background: #000; }
        p { color: #888; }
    </style>
</head>
<body>
    <h1>DRONE BASE STATION</h1>
    <div class="stats">
        <div class="box">ROLL <span id="roll" class="val">0</span></div>
        <div class="box">PITCH <span id="pitch" class="val">0</span></div>
        <div class="box">YAW <span id="yaw" class="val">0</span></div>
        <div class="box">ALT <span id="alt" class="val">0</span></div>
    </div>
    <h3>LATEST SNAPSHOT (2s Interval)</h3>
    <img id="snap" src="" alt="Waiting for Drone...">
    <p>All snapshots are saved in the 'snapshots' folder.</p>

    <script>
        function update() {
            fetch('/get_data').then(r => r.json()).then(data => {
                document.getElementById('roll').innerText = data.roll + "°";
                document.getElementById('pitch').innerText = data.pitch + "°";
                document.getElementById('yaw').innerText = data.yaw + "°";
                document.getElementById('alt').innerText = data.alt + "m";
                // Refresh image with unique timestamp to bypass browser cache
                document.getElementById('snap').src = "/snapshots/latest.jpg?t=" + new Date().getTime();
            });
        }
        setInterval(update, 1000); 
    </script>
</body>
</html>
"""

@app.route('/')
def index(): return render_template_string(HTML_PAGE)

@app.route('/get_data')
def get_data(): return jsonify(latest_telemetry)

@app.route('/upload', methods=['POST'])
def upload():
    global latest_telemetry
    # 1. Update Telemetry
    latest_telemetry = {k: v for k, v in request.form.items()}
    # 2. Save Image
    if 'image' in request.files:
        file = request.files['image']
        ts = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
        # Save permanent timestamped copy
        file.save(os.path.join(SAVE_DIR, f"snap_{ts}.jpg"))
        # Save latest copy for the web dashboard
        file.seek(0)
        file.save(os.path.join(SAVE_DIR, "latest.jpg"))
    return "OK", 200

@app.route('/snapshots/<filename>')
def serve(filename): return send_from_directory(SAVE_DIR, filename)

if __name__ == '__main__':
    app.run(host='0.0.0.0', port=5000)
