# ─────────────────────────────────────────
#  DRONE SENSOR NODE - RPi 2
#  OS: Ubuntu 24.04 LTS
#
#  Install:
#    pip install smbus2
#
#  Enable I2C:
#    sudo nano /boot/firmware/config.txt
#    Add: dtparam=i2c_arm=on
#    sudo reboot
#
#  Verify ADS1015:
#    i2cdetect -y 1  (should show 0x48)
# ─────────────────────────────────────────

import time
import socket
from smbus2 import SMBus

# ─────────────────────────────────────────
#  Configuration
#  !! Set BASE_STATION_IP to RPi 1's IP !!
# ─────────────────────────────────────────
BASE_STATION_IP   = "10.10.24.27"   # <-- Change to RPi 1's IP
BASE_STATION_PORT = 8888
SEND_INTERVAL     = 0.5              # seconds between readings

# ─────────────────────────────────────────
#  ADS1015 Register & Config
# ─────────────────────────────────────────
ADS1015_ADDR       = 0x48
ADS1015_REG_CONV   = 0x00
ADS1015_REG_CONFIG = 0x01

# Config word:
#   OS=1         single conversion start
#   MUX=100      AIN0 vs GND
#   PGA=001      ±4.096V FSR
#   MODE=1       single shot
#   DR=100       1600 SPS
#   COMP disabled
CONFIG = (0x8000 |   # OS: start conversion
          0x4000 |   # MUX: AIN0/GND
          0x0200 |   # PGA: ±4.096V
          0x0100 |   # MODE: single-shot
          0x0080 |   # DR: 1600 SPS
          0x0003)    # COMP: disable

FSR         = 4.096  # must match PGA above
R1          = 50000
R2          = 10000
RATIO       = (R1 + R2) / R2
CALIBRATION = 14.93 / 14.79

def read_voltage():
    with SMBus(1) as bus:
        # Write config — triggers single conversion
        msb = (CONFIG >> 8) & 0xFF
        lsb = CONFIG & 0xFF
        bus.write_i2c_block_data(ADS1015_ADDR, ADS1015_REG_CONFIG, [msb, lsb])

        # Wait for conversion to complete (~1ms at 1600SPS, use 10ms)
        time.sleep(0.01)

        # Read 2 bytes from conversion register
        data = bus.read_i2c_block_data(ADS1015_ADDR, ADS1015_REG_CONV, 2)

    # ADS1015 is 12-bit, result in upper 12 bits → shift right 4
    raw = (data[0] << 8 | data[1]) >> 4

    # Two's complement for negative values
    if raw > 2047:
        raw -= 4096

    v_adc  = raw * FSR / 2047
    v_batt = round(v_adc * RATIO * CALIBRATION, 2)
    return v_batt

# ─────────────────────────────────────────
#  Send voltage to Base Station
# ─────────────────────────────────────────
def send_voltage(voltage):
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        s.settimeout(2)
        s.connect((BASE_STATION_IP, BASE_STATION_PORT))
        msg = f"VOLT:{voltage}"
        s.sendall(msg.encode())
        s.close()
        print(f"[>] Sent: {msg}")
    except Exception as e:
        print(f"[!] Send error: {e}")

# ─────────────────────────────────────────
#  Startup I2C Check
# ─────────────────────────────────────────
print("=========================")
print("  Drone Sensor Node")
print(f"  Target: {BASE_STATION_IP}:{BASE_STATION_PORT}")
print("=========================")

try:
    with SMBus(1) as bus:
        bus.read_byte(ADS1015_ADDR)
    print(f"[OK] ADS1015 found at 0x{ADS1015_ADDR:02X}")
except Exception as e:
    print(f"[!!] ADS1015 not found: {e}")
    print("     Check wiring and run: i2cdetect -y 1")
    exit(1)

# ─────────────────────────────────────────
#  Main Loop
# ─────────────────────────────────────────
try:
    while True:
        voltage = read_voltage()
        print(f"[V] Battery: {voltage}V")
        send_voltage(voltage)
        time.sleep(SEND_INTERVAL)

except KeyboardInterrupt:
    print("\n[-] Sensor node shutting down.")
